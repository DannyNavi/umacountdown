# Copy to server/.dev.vars for local wrangler dev (never commit .dev.vars)
# Production: wrangler secret put OSHI_ADMIN_PASSWORD
#             wrangler secret put OSHI_ADMIN_TOKEN
#             wrangler secret put GEMINI_API_KEY   (optional AI commentary)
#             wrangler secret put key             (uma.moe API; required for /parent lookup)

OSHI_ADMIN_USERNAME=admin
OSHI_ADMIN_PASSWORD=change-me
OSHI_ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional
# GEMINI_API_KEY=

# uma.moe API key (X-API-Key). Used by /api/v4/circles and /api/v4/practice.
# For local: copy this file to .dev.vars, or put `key=...` in `.env`
# (npm run dev copies .env → .dev.vars if .dev.vars is missing).
# key=uma_k_your_key_here
